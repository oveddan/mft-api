// Type-checks the test sources, which the build config deliberately excludes
// because `rootDir` is `src` and they must not be emitted into `dist`. Without
// this, a fixture generator could construct a malformed ConfigExport and only
// fail at CLI runtime.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
